          <stop offset="55%" stop-color="#FFF4D2" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#FFF4D2" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <g fill="url(#beam)" style="mix-blend-mode:screen">
        <polygon points="-80,-80 300,960 210,960"/>
        <polygon points="-80,-80 520,960 380,960"/>
        <polygon points="-80,-80 760,960 600,960"/>
        <polygon points="-80,-80 1010,960 860,960"/>
        <polygon points="-80,-80 1280,960 1130,960"/>
      </g>
    </svg>
  </div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="kicker">Seventy Times Seven &middot; Matthew 18:22</div>
      <h1>Live the 490 Life.</h1>
      <p class="hero-hook">When Peter asked how many times he had to forgive, Jesus ended the counting: <span class="gold">seventy times seven.</span> 490 isn't a number &mdash; it's a way of life with the God who keeps no record of wrongs.</p>
      <p class="hope-line">Weekly teachings from Scripture, a book about limitless grace, and a place to begin &mdash; wherever you stand with God.</p>
      <div class="hero-actions">
        <a href="#subscribe" class="btn btn-primary">Get the free study guide</a>
