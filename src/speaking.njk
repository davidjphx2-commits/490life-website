<script>
document.querySelectorAll('.video-tile').forEach(function (tile) {
  var v = tile.querySelector('video');
  function start() {
    tile.classList.add('playing');
    var p = v.play();
    if (p && p.catch) { p.catch(function () {}); }
    tile.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
  tile.querySelector('.play').addEventListener('click', function (e) { e.stopPropagation(); start(); });
  tile.addEventListener('click', function (e) {
    if (tile.classList.contains('playing')) return;   // native controls take over once playing
    e.preventDefault(); start();
  });
  v.addEventListener('play', function () { tile.classList.add('playing'); });
});
</script>
