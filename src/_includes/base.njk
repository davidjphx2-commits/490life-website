<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | 490 Life</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/assets/logo.png?v=3">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/logo.png' }}">
<meta property="og:site_name" content="490 Life">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<link rel="alternate" type="application/atom+xml" title="490 Life — Weekly Teachings" href="/feed.xml">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "490 Life",
  "url": "{{ site.url }}/",
  "description": "Weekly Bible teachings, resources for the Christian life, and the book Seventy Times Seven by David S. Jones — on the God who forgives past all counting.",
  "inLanguage": "en",
  "publisher": {
    "@type": "Person",
    "name": "David S. Jones",
    "url": "{{ site.url }}/about/"
  }
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=8">
</head>
<body>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/assets/logo.png?v=3" alt="490 Life" class="brand-logo">
      <span class="brand-word">490.life</span>
    </a>
    <nav class="site-nav">
      <a href="/teachings/">Teachings</a>
      <div class="nav-drop">
        <a href="/resources/">Resources <span class="drop-caret">&#9662;</span></a>
        <div class="drop-menu">
          <a href="/resources/">All Resources</a>
          <a href="/gospel/">The Gospel</a>
          <a href="/what-is-the-bible/">What Is the Bible?</a>
          <a href="/studying-the-bible/">Studying the Bible</a>
          <a href="/christian-life/">The Christian Life</a>
          <a href="/finding-a-church/">Finding a Church</a>
        </div>
      </div>
      <a href="/seventy-times-seven/">The Book</a>
      <a href="https://shop.490.life/">Shop</a>
      <a href="/about/">About</a>
      <a href="/#subscribe" class="btn btn-primary nav-cta">Join the List</a>
    </nav>
  </div>
</header>

<main id="top">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container">
    <a href="/" class="footer-brand">
      <img src="/assets/logo.png?v=3" alt="490 Life" class="footer-logo">
      <span class="footer-word">490.life</span>
    </a>
    <div class="footer-meta">
      490 = seventy times seven. <em>Matthew 18:22.</em><br>
      <a href="/teachings/">Teachings</a> · <a href="/seventy-times-seven/">The Book</a> · <a href="https://shop.490.life/">Shop</a> · <a href="/about/">About</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
      &copy; 2026 490 Life Publishing · Created by David S. Jones. All rights reserved.
    </div>
  </div>
</footer>

<script>
document.querySelectorAll("form.capture").forEach(function (f) {
  f.addEventListener("submit", async function (e) {
    e.preventDefault();
    var btn = f.querySelector("button[type=submit]");
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      await fetch(f.action, { method: "POST", mode: "no-cors", body: new FormData(f) });
      window.location.href = "/almost-there/";
    } catch (err) {
      btn.disabled = false;
      btn.textContent = "Try again";
    }
  });
});
</script>
</body>
</html>
