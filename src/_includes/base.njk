<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | 490 Life</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/assets/logo.png?v=3">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/david-headshot-beach.jpg' }}">
<meta property="og:site_name" content="490 Life">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<link rel="alternate" type="application/atom+xml" title="490 Life — Weekly Teachings" href="/feed.xml">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "490 Life",
  "url": "{{ site.url }}/",
  "description": "David S. Jones — weekly Bible teachings, biblical coaching and mentoring for men, speaking, and the book Seventy Times Seven, on the God who forgives past all counting.",
  "inLanguage": "en",
  "publisher": {
    "@type": "Person",
    "name": "David S. Jones",
    "url": "{{ site.url }}/about/"
  }
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=20260905i">
</head>
<body>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/assets/logo.png?v=3" alt="490 Life" class="brand-logo">
      <span class="brand-word">490.LIFE <small>Ministries</small></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav">
      <a href="/teachings/">Teachings</a>
      <a href="/coaching/">Coaching</a>
      <a href="/speaking/">Ministry &amp; Speaking</a>
      <a href="/seventy-times-seven/">The Book</a>
      <div class="nav-drop">
        <a href="/resources/">Resources <span class="drop-caret">&#9662;</span></a>
        <div class="drop-menu">
          <a href="/resources/">All Resources</a>
          <a href="/gospel/">The Gospel</a>
          <a href="/what-is-the-bible/">What Is the Bible?</a>
          <a href="/studying-the-bible/">Studying the Bible</a>
          <a href="/christian-life/">The Christian Life</a>
          <a href="/finding-a-church/">Finding a Church</a>
        </div>
      </div>
      <a href="https://shop.490.life/">Shop</a>
      <a href="/about/">About</a>
      <a href="/coaching/#talk" class="btn btn-primary nav-cta">Talk with David</a>
    </nav>
  </div>
</header>

<main id="top">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="/" class="footer-brand">
        <img src="/assets/logo.png?v=3" alt="490 Life" class="footer-logo">
        <span class="footer-word">490.LIFE <small>Ministries</small></span>
      </a>
      <p class="footer-meta">490 = seventy times seven. <em>Matthew 18:22.</em> Living the 490 life from Scottsdale, Arizona.</p>
    </div>
    <div>
      <h5>Read</h5>
      <ul>
        <li><a href="/teachings/">Teachings</a></li>
        <li><a href="/seventy-times-seven/">The Book</a></li>
        <li><a href="/resources/">Resources</a></li>
        <li><a href="/what-is-the-bible/">What Is the Bible?</a></li>
      </ul>
    </div>
    <div>
      <h5>Work with David</h5>
      <ul>
        <li><a href="/coaching/">Coaching for men</a></li>
        <li><a href="/speaking/">Ministry &amp; Speaking</a></li>
        <li><a href="/coaching/#talk">Talk with David</a></li>
      </ul>
    </div>
    <div>
      <h5>More</h5>
      <ul>
        <li><a href="/about/">About David</a></li>
        <li><a href="https://shop.490.life/">Shop</a></li>
        <li><a href="/finding-a-church/">Finding a church</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-fine"><div class="container">&copy; 2026 490 Life Publishing &middot; David S. Jones. All rights reserved. Scripture quotations from the ESV.</div></div>
</footer>

<script>
(function () {
  var t = document.querySelector(".nav-toggle"), n = document.getElementById("site-nav");
  if (t && n) {
    t.addEventListener("click", function () {
      var open = n.classList.toggle("open");
      t.setAttribute("aria-expanded", open ? "true" : "false");
      t.textContent = open ? "Close" : "Menu";
    });
  }
})();
document.querySelectorAll("form.capture").forEach(function (f) {
  f.addEventListener("submit", async function (e) {
    e.preventDefault();
    var btn = f.querySelector("button[type=submit]");
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      await fetch(f.action, { method: "POST", mode: "no-cors", body: new FormData(f) });
      window.location.href = "/almost-there/";
    } catch (err) {
      btn.disabled = false;
      btn.textContent = "Try again";
    }
  });
});
</script>
</body>
</html>
