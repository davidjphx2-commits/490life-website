---
layout: base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "about": {{ passage | dump | safe }},
  "url": "{{ site.url }}{{ page.url }}",
  "datePublished": "{{ page.date | isoDate }}",
  "inLanguage": "en",
  "image": "{{ site.url }}{{ ogImage or '/assets/logo.png' }}",
  "author": { "@type": "Person", "name": "David S. Jones", "url": "{{ site.url }}/about/" },
  "publisher": { "@type": "Person", "name": "David S. Jones", "url": "{{ site.url }}/" },
  "isPartOf": { "@type": "WebSite", "name": "490 Life", "url": "{{ site.url }}/" },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
<header class="post-header">
  <div class="container">
    <div class="kicker">{{ passage }}</div>
    <h1>{{ title }}</h1>
    <div class="date">{{ page.date | readableDate }} &middot; David S. Jones</div>
  </div>
</header>

<article class="post-body">
{{ content | safe }}

{% if bookCallout %}
<div class="book-callout">
  <strong>Go deeper on forgiveness.</strong> I wrote a whole book on the God who forgives past all counting &mdash; <a href="/seventy-times-seven/"><em>Seventy Times Seven</em></a>. If this teaching met you where you are, the book walks the whole road.
</div>
{% endif %}
</article>

