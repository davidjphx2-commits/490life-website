---
layout: base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "about": {{ passage | dump | safe }},
  "url": "{{ site.url }}{{ page.url }}",
  "datePublished": "{{ page.date | isoDate }}",
  "inLanguage": "en",
  "image": "{{ site.url }}{{ ogImage or '/assets/logo.png' }}",
  "author": { "@type": "Person", "name": "David S. Jones", "url": "{{ site.url }}/about/" },
  "publisher": { "@type": "Person", "name": "David S. Jones", "url": "{{ site.url }}/" },
  "isPartOf": { "@type": "WebSite", "name": "490 Life", "url": "{{ site.url }}/" },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
<header class="post-header">
  <div class="container post-header-inner">
    <img class="post-headshot" src="/assets/david-headshot-beach.jpg" alt="David S. Jones" width="88" height="88" loading="eager">
    <div class="kicker">{{ passage }}</div>
    <h1>{{ title }}</h1>
    <div class="date">{{ page.date | readableDate }} &middot; David S. Jones</div>
  </div>
</header>

<article class="post-body">
{% if youtube %}
<div class="video-note">
  <strong>Prefer to watch or listen?</strong> This lesson is also an animated, narrated video on the 490 Life YouTube channel. You can watch it, or simply listen along in YouTube.
  <a class="video-note-link" href="{{ youtube }}" target="_blank" rel="noopener">Watch {% if lesson %}Lesson {{ lesson }} {% endif %}on YouTube</a>
</div>
{% endif %}
{{ content | safe }}

{% if bookCallout %}
<div class="book-callout">
  <strong>Go deeper on forgiveness.</strong> I wrote a whole book on the God who forgives past all counting: <a href="/seventy-times-seven/"><em>Seventy Times Seven</em></a>. If this teaching met you where you are, the book walks the whole road.
</div>
{% endif %}
</article>

{% include "signup.njk" %}
