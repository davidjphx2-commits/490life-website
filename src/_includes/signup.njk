<section class="workbook section-line" id="subscribe">
  <div class="narrow center">
    <div class="eyebrow">The Weekly Teaching</div>
    <h2 class="section-title">Weekly teachings, straight to you.</h2>
    <p class="lead">One teaching from Scripture each week — plus the free study guide, <span class="gold">The Necessities for Effective Prayer</span> (Mark 11:22&ndash;25), the moment you confirm.</p>
    <form class="capture" method="POST" action="{{ site.brevoFormAction }}">
      <input type="text" name="email_address_check" value="" style="display:none" tabindex="-1" autocomplete="off">
      <input type="hidden" name="locale" value="en">
      <input type="hidden" name="html_type" value="simple">
      <input type="email" id="EMAIL" name="EMAIL" placeholder="your@email.com" autocomplete="email" required>
      <button type="submit" class="btn btn-primary">Get the study guide</button>
    </form>
    <p class="fineprint">No spam, ever. Unsubscribe anytime. You'll get a confirmation email first &mdash; click it and the guide is yours.</p>
  </div>
</section>
